{
  "manifest_version": 3,
  "name": "Kassensturz – Kassenbon-Export für Lidl Plus",
  "short_name": "Kassensturz",
  "version": "1.0.0",
  "description": "Exportiert deine Lidl Plus Kassenbons gesammelt als PDF, JSON und CSV – mit Zeitraum-Filter, direkt in einen Download-Ordner. Inoffiziell, nicht mit Lidl verbunden.",
  "author": "Florian Schneider",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "96": "icon96.png",
    "128": "icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "96": "icon96.png",
      "128": "icon128.png"
    },
    "default_title": "Kassensturz – Kassenbons öffnen"
  },
  "permissions": [
    "downloads"
  ],
  "host_permissions": [
    "https://www.lidl.de/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.lidl.de/*"
      ],
      "exclude_matches": [
        "https://www.lidl.de/mre/purchase-detail*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.lidl.de/mre/purchase-detail*"
      ],
      "js": [
        "jspdf.umd.min.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icon.svg",
        "receipt-mark.svg",
        "logo-watermark.svg"
      ],
      "matches": [
        "https://www.lidl.de/*"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "kassensturz@infraviored.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "background": {
    "scripts": [
      "bg.js"
    ]
  }
}